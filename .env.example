# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/horse_racing

# Подпись cookie авторизации. Поменяйте на свою длинную случайную строку.
SESSION_SECRET=change-me-please

# Этот администратор создаётся автоматически при первом запуске.
DEFAULT_ADMIN_EMAIL=admin@example.local
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=admin123
